@model List<MVC_1.Models.Movie>

@{
    ViewData["Title"] = "Топ 10 фільмів";
}

<h1 class="mb-4">Топ 10 фільмів</h1>

<div class="row">
    @foreach (var movie in Model)
    {
        <div class="col-md-4 col-lg-3 mb-4">
            <div class="card h-100">
                <img src="@movie.PosterUrl" class="card-img-top" alt="@movie.Title" style="height:350px; object-fit:cover;" />
                <div class="card-body">
                    <h5 class="card-title">@movie.Title (@movie.Year)</h5>
                    <p class="card-text mb-1"><strong>Режисер:</strong> @movie.Director</p>
                    <p class="card-text mb-1"><strong>Жанр:</strong> @movie.Genre</p>
                    <p class="card-text">@movie.Description</p>
                </div>
            </div>
        </div>
    }
</div>
